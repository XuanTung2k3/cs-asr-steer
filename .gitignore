# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Experiment outputs. Artifacts live under /mnt/data/tungnx/cs-asr-steer and are
# reproduced by the pipeline, not versioned: they are large, machine-specific,
# and their provenance is recorded in their own manifests.
artifacts*/
logs/
runs/
*.parquet
*.wav

# BASIS-A6 external ASCEND snapshot (dataset bytes are never committed).
data/external/ASCEND/hf_cache/
data/external/ASCEND/dataset/

# written by `cs_asr_lss.sh preflight`; machine-specific
environment.lock.txt

# editors / OS
.DS_Store
.idea/
.vscode/

# local agent state and worktrees
.claude/

# disposable smoke-test backup
out/smoke/results_A.pre_42674_debug_residue.jsonl.bak

# P0-R2 evaluator outputs derived from dataset reference transcripts (regenerable; keep out of Git)
results/inference_cf/p0_r2/evaluation_panel.json
results/inference_cf/p0_r2/evaluation_units.json

# P2-DIR large raw tensors stay local; their sha256 hashes are recorded in committed row/fold JSONs
results/inference_cf/p2dir/**/rows/*_logits.npz
results/inference_cf/p2dir/folds_*/arrays/
# P2-SEL arm logits stay local; sha256 recorded in committed row JSONs
results/inference_cf/p2sel/**/rows/*_logits.npz
# P2-SEL-E E1 C_new logits stay local; sha256 in committed row JSONs
results/inference_cf/p2sel_e/**/rows/*_logits.npz
# P2-SEL-T T1 C_new logits stay local; sha256 in committed row JSONs
results/inference_cf/p2sel_t/t1_run*/rows/*_logits.npz
# P2-SEL-XA raw logits (r1 / r0.95) stay local; sha256 in committed row JSONs
results/inference_cf/p2sel_xa/**/rows/*_logits.npz
# P2-SEL-LAC masked raw logits stay local; sha256 in committed row JSONs
results/inference_cf/p2sel_lac/**/rows/*_logits.npz
# SRD2-G0 lossless raw arrays stay local + immutable content-addressed archive under
# /mnt/data/tungnx/cs-asr-steer/archives/srd2_g0/; sha256 in committed row JSONs and phase seals
results/inference_cf/srd2_g0/**/gate/*.npz
results/inference_cf/srd2_g0/**/pulses/*.npz
# SRD2-G0 evaluator unit ledger contains reference-derived surfaces (hash recorded in evaluation.json)
results/inference_cf/srd2_g0/**/evaluation_units.json
# DIR-SPRINT0 lossless raw arrays stay local + immutable content-addressed archive under
# /mnt/data/tungnx/cs-asr-steer/archives/dir_sprint0/; sha256 in committed row JSONs and phase seals
results/inference_cf/dir_sprint0/run1/**/*.npz
# DIR-SPRINT0 evaluator unit ledger contains reference-derived surfaces (hash recorded in evaluation.json)
results/inference_cf/dir_sprint0/run1/evaluation_units.json
